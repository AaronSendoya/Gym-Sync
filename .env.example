# ============ DATABASE ============
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=bdd_gym_sync

# ============ JWT ============
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# ============ SERVER ============
PORT=3000
NODE_ENV=development

# Solo se usa cuando NODE_ENV=production. Dominios del frontend permitidos por CORS,
# separados por coma (ej: https://app.gymsync.com,https://admin.gymsync.com).
# Si falta en producción, se bloquean todas las peticiones cross-origin.
CORS_ORIGINS=

# ============ MIGRATION ============
# Activar SOLO la primera vez para recrear tablas desde cero.
# Después de la primera ejecución exitosa, cambiar a false o eliminar.
#cp .env.example .env
DROP_SCHEMA=false

# ============ SMTP (Nodemailer) ============
# Gmail: habilita "Contraseñas de aplicación" en tu cuenta Google.
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx